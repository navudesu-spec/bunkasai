<DOCTYPE html>
<head>
<meta charset="utf-8">
<script src="https://aframe.io/releases/0.8.2/afraim.min.js"></script>
<script src="https://cdn.rawgit.com/jeromeetienne/AR.js/1.6.2/aframe/build/aframe-ar.js"
></script>
</head>
<body style='margin: 0; overflow: hidden;'>
<a-scene embedded arjs="debugUIEnabled:false;">

 <a-assets timeout="10000">
	<a-asset-item id="bouningen_gltf" src="/yarakasita.glb"></a-asset-item>
</a-assets>

 <a-marker preset="hiro">
   <a-gltf-model src="#bouningen_gltf" position="-5 5 -15" rotation="0 -20 0"></a-gltf-model>
 </a-marker>

<a-marker type="pattern" url="pattern-IMG_3680.patt">
    <a-sphere scale=".25 .25 .25" position="0 .5 0" color="#f00">
      <a-animation attribute="position" to="0 1 0" direction="alternate" dur="2000" repeat="indefinite">
      </a-animation>
    </a-sphere>
  </a-marker>

 <a-entity camera></a-entity>
</a-scene>
</body>
</html>
 
